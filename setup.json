-9045-40de-9f7e-c81dcc14c042","label":"Snap point","position":{"x":0.4468038705267662,"y":2.0923,"z":0.4750450096019723},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-3f9df447-fb3f-4af0-840a-05f0cded5780","label":"Snap point","position":{"x":0.6208038705267662,"y":2.0923,"z":0.4750450096019723},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-61e6a176-12f5-4574-8fd8-19a757780c72","label":"Snap point","position":{"x":-0.5971961294732337,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-c1653a29-086a-454a-90a5-2141f4fdcedb","label":"Snap point","position":{"x":-0.4231961294732337,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-5fee391e-02a2-4ea2-bb08-34e6c8fa7c8c","label":"Snap point","position":{"x":-0.24919612947323377,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-8901965f-88bf-4aa6-907f-e9e1be3e756a","label":"Snap point","position":{"x":-0.07519612947323376,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-40ccadd2-034b-4529-9e4a-f8a83fb5a50f","label":"Snap point","position":{"x":0.09880387052676623,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-ad086b07-2f34-4aa0-92b6-f002b1f5e93a","label":"Snap point","position":{"x":0.27280387052676625,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-3d5d6c80-22de-4617-bb66-213e8bee4ab2","label":"Snap point","position":{"x":0.4468038705267662,"y":2.0923,"z":0.6490450096019724},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}},{"id":"snap-05499513-9cf3-4408-bef2-d425330d5b86","label":"Snap point","position":{"x":0.6166465760560776,"y":2.0923,"z":0.6419166853434211},"rotationY":0,"snapRadius":0.12,"ownerSeat":null,"metadata":{}}],"scripts":[{"id":"script-dc8ed9ec-0cac-4406-aac9-caed60994a31","name":"board-1.ts","language":"typescript","source":"// Chess capture — attach ONE of these to the Scene (Scripts section), not to pieces.\n\nconst PIECE_TAG = \"piece\";\nconst CAPTURE_ZONE_NAME = \"CaptureZone\";\nconst SETTLE_SECONDS = 0.25;\n\n/** ownerObjectId -> ids currently inside that piece's trigger volume. */\nconst occupants = new Map<string, Set<string>>();\n/** How many pieces each side has already taken, for laying the pile out. */\nconst takenBy = new Map<string, number>();\n\nglobalEvents.onTriggerEnter.add((ev) => {\n  let inside = occupants.get(ev.ownerObjectId);\n  if (!inside) {\n    inside = new Set<string>();\n    occupants.set(ev.ownerObjectId, inside);\n  }\n  inside.add(ev.objectId);\n});\n\nglobalEvents.onTriggerLeave.add((ev) => {\n  occupants.get(ev.ownerObjectId)?.delete(ev.objectId);\n});\n\nglobalEvents.onObjectDestroyed.add((id) => {\n  occupants.delete(id);\n  for (const inside of occupants.values()) inside.delete(id);\n});\n\nglobalEvents.onObjectDropped.add((mover) => {\n  void resolveCapture(mover);\n});\n\nasync function resolveCapture(mover: ObjectHandle): Promise<void> {\n  if (!mover.tags.includes(PIECE_TAG)) return;\n\n  // Let the body settle and the host re-sample the volumes before deciding.\n  await world.wait(SETTLE_SECONDS);\n  const dropped = await mover.refresh();\n  if (!dropped) return;\n\n  const attacker = sideOf(dropped);\n  if (!attacker) return;\n\n  for (const [ownerId, inside] of occupants) {\n    if (ownerId === dropped.id || !inside.has(dropped.id)) continue;\n\n    const victim = await world.getObjectById(ownerId);\n    if (!victim || !victim.tags.includes(PIECE_TAG)) continue;\n    if (sideOf(victim) === attacker) continue; // own piece — not a capture\n\n    await sendToCaptureZone(victim, attacker);\n    return;\n  }\n}\n\nfunction sideOf(piece: ObjectData): string | null {\n  if (piece.tags.includes(\"white\")) return \"white\";\n  if (piece.tags.includes(\"black\")) return \"black\";\n  return null;\n}\n\nasync function sendToCaptureZone(victim: ObjectHandle, capturer: string): Promise<void> {\n  const zones = await world.getSeatZones(capturer);\n  const zone = zones.find((z) => z.name.toLowerCase() === CAPTURE_ZONE_NAME.toLowerCase());\n  if (!zone) {\n    world.log(`No \"${CAPTURE_ZONE_NAME}\" zone on seat ${capturer} — capture not moved.`);\n    return;\n  }\n\n  const index = takenBy.get(capturer) ?? 0;\n  takenBy.set(capturer, index + 1);\n\n  const perRow = 8;\n  const stepX = zone.size[0] / perRow;\n  const stepZ = zone.size[2] / perRow;\n  const x = zone.position[0] - zone.size[0] / 2 + stepX * (index % perRow) + stepX / 2;\n  const z = zone.position[2] - zone.size[2] / 2 + stepZ * Math.floor(index / perRow) + stepZ / 2;\n\n  victim.setPosition([x, zone.position[1], z]);\n  victim.lock(); // keep it parked instead of rolling around the tray\n\n  world.broadcast(`${capturer} captures ${victim.name ?? \"a piece\"}.`);\n}","compiled":"\"use strict\";\n// Chess capture — attach ONE of these to the Scene (Scripts section), not to pieces.\nconst PIECE_TAG = \"piece\";\nconst CAPTURE_ZONE_NAME = \"CaptureZone\";\nconst SETTLE_SECONDS = 0.25;\n/** ownerObjectId -> ids currently inside that piece's trigger volume. */\nconst occupants = new Map();\n/** How many pieces each side has already taken, for laying the pile out. */\nconst takenBy = new Map();\nglobalEvents.onTriggerEnter.add((ev) => {\n    let inside = occupants.get(ev.ownerObjectId);\n    if (!inside) {\n        inside = new Set();\n        occupants.set(ev.ownerObjectId, inside);\n    }\n    inside.add(ev.objectId);\n});\nglobalEvents.onTriggerLeave.add((ev) => {\n    occupants.get(ev.ownerObjectId)?.delete(ev.objectId);\n});\nglobalEvents.onObjectDestroyed.add((id) => {\n    occupants.delete(id);\n    for (const inside of occupants.values())\n        inside.delete(id);\n});\nglobalEvents.onObjectDropped.add((mover) => {\n    void resolveCapture(mover);\n});\nasync function resolveCapture(mover) {\n    if (!mover.tags.includes(PIECE_TAG))\n        return;\n    // Let the body settle and the host re-sample the volumes before deciding.\n    await world.wait(SETTLE_SECONDS);\n    const dropped = await mover.refresh();\n    if (!dropped)\n        return;\n    const attacker = sideOf(dropped);\n    if (!attacker)\n        return;\n    for (const [ownerId, inside] of occupants) {\n        if (ownerId === dropped.id || !inside.has(dropped.id))\n            continue;\n        const victim = await world.getObjectById(ownerId);\n        if (!victim || !victim.tags.includes(PIECE_TAG))\n            continue;\n        if (sideOf(victim) === attacker)\n            continue; // own piece — not a capture\n        await sendToCaptureZone(victim, attacker);\n        return;\n    }\n}\nfunction sideOf(piece) {\n    if (piece.tags.includes(\"white\"))\n        return \"white\";\n    if (piece.tags.includes(\"black\"))\n        return \"black\";\n    return null;\n}\nasync function sendToCaptureZone(victim, capturer) {\n    const zones = await world.getSeatZones(capturer);\n    const zone = zones.find((z) => z.name.toLowerCase() === CAPTURE_ZONE_NAME.toLowerCase());\n    if (!zone) {\n        world.log(`No \"${CAPTURE_ZONE_NAME}\" zone on seat ${capturer} — capture not moved.`);\n        return;\n    }\n    const index = takenBy.get(capturer) ?? 0;\n    takenBy.set(capturer, index + 1);\n    const perRow = 8;\n    const stepX = zone.size[0] / perRow;\n    const stepZ = zone.size[2] / perRow;\n    const x = zone.position[0] - zone.size[0] / 2 + stepX * (index % perRow) + stepX / 2;\n    const z = zone.position[2] - zone.size[2] / 2 + stepZ * Math.floor(index / perRow) + stepZ / 2;\n    victim.setPosition([x, zone.position[1], z]);\n    victim.lock(); // keep it parked instead of rolling around the tray\n    world.broadcast(`${capturer} captures ${victim.name ?? \"a piece\"}.`);\n}\n","refKind":"board","variables":[],"updatedAt":"2026-09-17T20:47:34.845Z"}]}